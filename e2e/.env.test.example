# Copy this to e2e/.env.test and fill in your local values.
# This file is safe to commit. e2e/.env.test is gitignored.
#
# Tests run on dedicated ports (3001/5174) to avoid conflicts with the dev server.

TEST_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/helpdesk_test?schema=public
BETTER_AUTH_SECRET=test-secret-helpdesk-e2e-testing-only-safe
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:5174

TEST_ADMIN_EMAIL=admin@test.local
TEST_ADMIN_PASSWORD=Admin1234!
TEST_AGENT_EMAIL=agent@test.local
TEST_AGENT_PASSWORD=Agent1234!
